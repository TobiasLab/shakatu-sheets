{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "biome.json",
            "package.json",
            "tsconfig.json",
            "tsconfig.node.json",
            "vite.config.ts",
            "src/**",
            "scripts/*loot*.mjs",
            "scripts/smoke-desktop.mjs",
            "scripts/smoke-session-overlay.mjs",
            "scripts/benchmark-session-format.mjs",
            "scripts/sync-grind-spots.mjs",
            "scripts/sync-grind-buffs.mjs",
            "scripts/grind-spots.test.mjs"
        ]
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "css": {
        "linter": {
            "enabled": true
        },
        "parser": {
            "cssModules": true
        },
        "formatter": {
            "enabled": true,
            "indentWidth": 4,
            "indentStyle": "space",
            "lineWidth": 120,
            "quoteStyle": "double"
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "correctness": {
                "useExhaustiveDependencies": "off"
            },
            "a11y": {
                "useKeyWithClickEvents": "warn",
                "noLabelWithoutControl": "warn",
                "useSemanticElements": "warn"
            },
            "suspicious": {
                "noArrayIndexKey": "warn",
                "noConsole": {
                    "level": "error",
                    "options": {
                        "allow": ["error", "info", "warn"]
                    }
                }
            },
            "style": {
                "noDefaultExport": "error",
                "useDefaultSwitchClause": "warn",
                "noDescendingSpecificity": "off"
            },
            "performance": {
                "noBarrelFile": "error"
            },
            "complexity": {
                "noImportantStyles": "off"
            }
        }
    },
    "overrides": [
        {
            "includes": ["**/tsconfig*.json"],
            "json": {
                "parser": {
                    "allowComments": true
                }
            }
        },
        {
            "includes": ["**/*.config.ts", "**/*.config.js", "commitlint.config.mjs"],
            "linter": {
                "rules": {
                    "style": {
                        "noDefaultExport": "off"
                    }
                }
            }
        },
        {
            "includes": ["scripts/*loot*.mjs"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noConsole": "off"
                    }
                }
            }
        }
    ]
}
