{
    "name": "shakatu-sheets",
    "private": true,
    "version": "0.1.0",
    "license": "AGPL-3.0-only",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "benchmark:loot:sample": "vite-node --script scripts/sample-loot-video.mjs",
        "benchmark:loot:track": "vite-node --script scripts/benchmark-loot-tracker.mjs",
        "benchmark:loot:ocr": "vite-node --script scripts/benchmark-loot-ocr.mjs",
        "benchmark:loot:roi": "vite-node --script scripts/benchmark-loot-roi.mjs",
        "benchmark:loot:e2e": "vite-node --script scripts/benchmark-loot-e2e.mjs",
        "benchmark:marni": "node scripts/benchmark-marni.mjs",
        "bundle:windows": "tauri build --bundles nsis",
        "test:desktop": "node scripts/smoke-desktop.mjs",
        "bundle:linux": "NO_STRIP=1 tauri build",
        "check": "biome check .",
        "check:write": "biome check --write .",
        "format": "biome format --write .",
        "test": "vitest run",
        "test:ui": "node scripts/smoke-loot-ui.mjs",
        "tauri": "tauri"
    },
    "dependencies": {
        "@tauri-apps/api": "^2",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "tesseract.js": "^7.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.9",
        "@tauri-apps/cli": "^2",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "@vitejs/plugin-react": "^4.6.0",
        "typescript": "~5.8.3",
        "vite": "^7.0.4",
        "vite-node": "3.2.4",
        "vitest": "^3.2.4"
    }
}
