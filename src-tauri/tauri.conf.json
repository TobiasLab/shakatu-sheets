{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shakatu Sheets",
  "version": "0.1.0",
  "identifier": "io.github.shakatusheets",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Shakatu Sheets",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680
      },
      {
        "label": "session-overlay",
        "title": "Session overlay",
        "url": "index.html",
        "width": 360,
        "height": 250,
        "minWidth": 320,
        "minHeight": 180,
        "visible": false,
        "focus": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "deb": {
        "depends": ["libgtk-layer-shell0 (>= 0.6)"]
      },
      "rpm": {
        "depends": ["gtk-layer-shell"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
